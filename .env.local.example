# Environment Variables - Jean Monnet Serious Game

# ============================================================================
# SUPABASE (Required for Authentication)
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# DATABASE (Local Development with Docker)
# ============================================================================
# This connects to the PostgreSQL container defined in docker-compose.yml
# No need to change this unless you modify docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jeanmonnet

# For use inside Docker containers (different hostname)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/jeanmonnet

# ============================================================================
# REDIS (Local Development with Docker)
# ============================================================================
# This connects to the Redis container defined in docker-compose.yml
REDIS_URL=redis://localhost:6379

# For use inside Docker containers (different hostname)
# REDIS_URL=redis://redis:6379

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=development
