--
-- Name: view_counter_achievements; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.view_counter_achievements AS
 SELECT u.id AS user_id,
    count(
        CASE
            WHEN (q.score IS NOT NULL) THEN 1
            ELSE NULL::integer
        END) AS quizzes_done,
    count(
        CASE
            WHEN (q.score >= 70) THEN 1
            ELSE NULL::integer
        END) AS quizzes_passed,
    count(
        CASE
            WHEN (q.score = 100) THEN 1
            ELSE NULL::integer
        END) AS quizzes_perfect
   FROM (public.users u
     LEFT JOIN public.quizzes q ON ((u.id = q.user_id)))
  GROUP BY u.id;


