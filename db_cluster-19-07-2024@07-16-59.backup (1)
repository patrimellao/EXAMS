--
-- Name: view_unit_question_count _RETURN; Type: RULE; Schema: public; Owner: postgres
--

CREATE OR REPLACE VIEW public.view_unit_question_count AS
 SELECT u.id AS unit_id,
    u.description,
    u.subject_id,
    u.active,
    u.name,
    u.questions_per_quiz,
    count(q.id) AS question_count,
    ((count(q.id))::smallint / u.questions_per_quiz) AS number_of_quizzes
   FROM (public.units u
     LEFT JOIN public.questions q ON ((u.id = q.unit_id)))
  GROUP BY u.id;


