# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-at-least-32-characters-long
# Full URL of your app (used by the auth client and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (local Docker) ──────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jeanmonnet

# ─── Redis (local Docker) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Lemon Squeezy (billing) ──────────────────────────────────────────────────
# Create a store at https://app.lemonsqueezy.com
# Add a webhook pointing to https://yourdomain.com/api/webhooks/lemonsqueezy
# with events: subscription_created, subscription_updated, subscription_cancelled,
# subscription_expired, subscription_resumed, subscription_paused,
# subscription_payment_failed, subscription_unpaused
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-signing-secret
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key

# ─── Cloudflare R2 (file storage) ─────────────────────────────────────────────
# Create a bucket at https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=jeanmonnet-resources
# Public URL for the R2 bucket (set up custom domain or use the default r2.dev URL)
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Playwright / E2E test variables ─────────────────────────────────────────
# Run `npm run seed` once to populate these values automatically.
# The seed script will print the correct values after it finishes.
TEACHER_EMAIL=teacher@exams.test
TEACHER_PASSWORD=Teacher123!
STUDENT_EMAIL=student1@exams.test
STUDENT_PASSWORD=Student123!
# IDs printed by `npm run seed` — update after each fresh seed
TEST_SUBJECT_ID=1
TEST_UNIT_ID=1
TEST_LOCKED_UNIT_ID=2
TEST_LESSON_ID=1
